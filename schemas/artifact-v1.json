{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voynich.win/schemas/artifact-v1.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "origin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "byte_length": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "rights": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "redistribution": {
      "enum": [
        "permitted",
        "reference_only",
        "unknown"
      ]
    },
    "state": {
      "enum": [
        "awaiting_transfer",
        "quarantined",
        "verified",
        "accepted",
        "unavailable",
        "checksum_mismatch",
        "withdrawn"
      ]
    },
    "attribution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "retention": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    }
  },
  "required": [
    "schema_version",
    "id",
    "sha256",
    "byte_length",
    "media_type",
    "source_id",
    "rights",
    "redistribution",
    "state",
    "attribution",
    "retention"
  ],
  "additionalProperties": false
}
