{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voynich.win/schemas/decision-v1.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "enum": [
        "award",
        "upgrade",
        "assess_zero",
        "decline_credit",
        "settle_withheld",
        "release_allocation",
        "reassign_attribution",
        "correct",
        "revoke",
        "restore"
      ]
    },
    "family_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "category": {
      "enum": [
        "sources_history",
        "corpus_annotations",
        "proposals",
        "tools_methods",
        "experiments",
        "replications_audits",
        "research_enablement",
        "publication_synthesis"
      ]
    },
    "repository_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "milestone_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "earned_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "posted_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "artifact_binding_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authority_receipt_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "cumulative_tier": {
      "enum": [
        0,
        2,
        5,
        10,
        20
      ]
    },
    "allocation_shares": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "github_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "reservation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          },
          "share_basis_points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "status": {
            "enum": [
              "paid",
              "held"
            ]
          },
          "acknowledgment_receipt_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        },
        "required": [
          "share_basis_points",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "target_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "replacement_allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "github_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "reservation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          },
          "units": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "enum": [
              "paid",
              "held"
            ]
          },
          "acknowledgment_receipt_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        },
        "required": [
          "units",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "factual_receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    }
  },
  "required": [
    "schema_version",
    "id",
    "sequence",
    "kind",
    "family_id",
    "rubric_version",
    "category",
    "repository_id",
    "pr_number",
    "milestone_id",
    "earned_at",
    "posted_at",
    "assessment_id",
    "artifact_binding_digest",
    "authority_receipt_ref",
    "cumulative_tier",
    "reason"
  ],
  "additionalProperties": false
}
