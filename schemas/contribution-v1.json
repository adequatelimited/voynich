{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voynich.win/schemas/contribution-v1.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "kind": {
      "enum": [
        "research",
        "direction",
        "artifact",
        "profile",
        "governance",
        "maintenance",
        "appeal"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "branch_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "github_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "github_login": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "minItems": 1,
            "maxItems": 1000
          }
        },
        "required": [
          "github_id",
          "github_login",
          "roles"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "ai_usage": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "none",
            "assisted",
            "primarily_generated"
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "model_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "model_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "accessed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "minItems": 0,
                "maxItems": 1000
              },
              "human_verification": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            },
            "required": [
              "provider",
              "model_id",
              "model_version",
              "accessed_at",
              "tasks",
              "human_verification"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "reproducibility_notes": {
          "type": "string",
          "maxLength": 12000
        }
      },
      "required": [
        "status",
        "tools",
        "reproducibility_notes"
      ],
      "additionalProperties": false
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "improvement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        },
        "required": [
          "path",
          "improvement"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          },
          "family_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          },
          "extends": {},
          "before": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "after": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "acceptance_test": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "minItems": 1,
            "maxItems": 1000
          },
          "related_outcomes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "claimed_cumulative_tier": {
            "enum": [
              0,
              2,
              5,
              10,
              20
            ]
          },
          "claimed_incremental_points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "claim_rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "attribution": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "github_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "reservation_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
                },
                "share_basis_points": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              },
              "required": [
                "share_basis_points"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": [
          "id",
          "family_id",
          "before",
          "after",
          "acceptance_test",
          "evidence",
          "related_outcomes",
          "claimed_cumulative_tier",
          "claimed_incremental_points",
          "claim_rationale",
          "attribution"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "claimed_total_points": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "rights_manifest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "local_estimate_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "title",
    "summary",
    "branch_ids",
    "contributors",
    "ai_usage",
    "changes",
    "outcomes",
    "claimed_total_points",
    "rubric_version",
    "conflicts",
    "limitations",
    "rights_manifest"
  ],
  "additionalProperties": false
}
